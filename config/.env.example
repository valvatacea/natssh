# ==============================================================================
# natssh — konfigurasi contoh (copy ke .env dan isi nilai masing-masing VPS)
# Jangan commit .env asli (state per-server, berisi kredensial).
# ==============================================================================

# Domain Cloudflare (kartu akun)
DOMAIN=id1.xenonblue.qzz.io

# Domain CloudFront (kartu akun, jalur kedua)
DOMAIN_CF=d3scfoym2c1or7.cloudfront.net

# Sembunyikan IP di kartu akun (1=ya, 0=tidak)
HIDE_IP=1

# Interface jaringan untuk speed limit (tc)
IFACE=eth0

# Mode speed limit
MODE=cdn-split

# Limit upload/download Cloudflare
UP_CF=100mbit
DOWN_CF=100mbit

# Limit upload/download CloudFront
UP_CFRONT=100mbit
DOWN_CFRONT=100mbit

# Durasi suspend otomatis (menit)
SUSPEND_MINUTES=15

# Port listener WebSocket ws.py
NATSSH_WS_PORT=20165

# Port listener SSH direct (raw TCP)
NATSSH_SSH_DIRECT_PORT=20169

# Nyalakan listener SSH direct (1=ya, 0=tidak)
NATSSH_SSH_DIRECT_ENABLED=1

# Terima header PROXY dari nginx stream (1=ya, 0=tidak)
NATSSH_PROXY_PROTOCOL=1

# TCP keepalive untuk soket WS (1=ya, 0=tidak)
NATSSH_TCP_HEARTBEAT=1

# Maks koneksi keseluruhan ws.py
NATSSH_MAX_TOTAL=150

# Maks koneksi per IP ws.py
NATSSH_MAX_PER_IP=10

# Maks perangkat per akun (crontab autokill)
MAX_LOGIN=5

# Cloudflare API Token (modern, disarankan)
CF_Token=

# Cloudflare API Key (legacy, global key) — pakai salah satu dengan CF_Token
CF_Key=

# Cloudflare Account Email (pasangan CF_Key)
CF_Email=
