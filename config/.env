CF_Key=
CF_Email=
NATSSH_MAX_PER_IP=15
NATSSH_IDLE_TIMEOUT=300
NATSSH_MAX_CONN_AGE=3600
NATSSH_SSH_PORT=22

# Nginx ports (synced from .env to nginx config files via menu)
NGINX_REVERSE_PORT=20865
NGINX_STREAM_PORT=20869
