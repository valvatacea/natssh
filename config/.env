# NATSSH Configuration — consolidated
# Generated from individual config files

DOMAIN=id1.xenonblue.qzz.io
DOMAIN_CF=d2bv7k4k37mb04.cloudfront.net
HIDE_IP=0
SUSPEND_MINUTES=2
NATSSH_WS_PORT=20165
NATSSH_MAX_TOTAL=150
NATSSH_SSH_DIRECT_ENABLED=1
NATSSH_SSH_DIRECT_PORT=20169
NATSSH_PROXY_PROTOCOL=1
NATSSH_TCP_KEEPALIVE=1
